{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ChangeRecordsInTheClusterZoneOnly",
      "Effect": "Allow",
      "Action": [
        "route53:ChangeResourceRecordSets",
        "route53:ListResourceRecordSets",
        "route53:ListTagsForResources"
      ],
      "Resource": [
        "arn:aws:route53:::hostedzone/Z0123456789EXAMPLE"
      ]
    },
    {
      "Sid": "FindTheZone",
      "Effect": "Allow",
      "Action": [
        "route53:ListHostedZones"
      ],
      "Resource": [
        "*"
      ]
    }
  ]
}
