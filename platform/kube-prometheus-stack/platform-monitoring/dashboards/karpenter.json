{
  "uid": "platform-karpenter",
  "title": "Platform / Karpenter",
  "tags": [
    "platform",
    "karpenter",
    "eks"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus"
      },
      {
        "name": "nodepool",
        "label": "NodePool",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(karpenter_nodepools_limit, nodepool)",
          "refId": "nodepool"
        },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Controller up",
      "description": "Karpenter controller pods being scraped. 0 fires KarpenterControllerDown.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(up{job=\"karpenter\"}) or vector(0)",
          "legendFormat": ""
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Pending pods",
      "description": "Pods waiting for a node, cluster-wide. Karpenter should bring this back to 0 within minutes.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(kube_pod_status_phase{phase=\"Pending\"})",
          "legendFormat": ""
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Nodes managed",
      "description": "Nodes launched by Karpenter in the selected NodePools.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(count by (node_name) (karpenter_nodes_allocatable{nodepool=~\"$nodepool\"}))",
          "legendFormat": ""
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "EC2 errors (1h)",
      "description": "Failed EC2 API calls in the last hour. Sustained errors fire KarpenterCloudProviderErrors.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(karpenter_cloudprovider_errors_total[1h])) or vector(0)",
          "legendFormat": ""
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "NodePool CPU usage vs limit",
      "description": "At 100% Karpenter stops launching nodes for the NodePool. KarpenterNodePoolNearLimit fires at 90%.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (nodepool) (karpenter_nodepools_usage{resource_type=\"cpu\", nodepool=~\"$nodepool\"}) / max by (nodepool) (karpenter_nodepools_limit{resource_type=\"cpu\", nodepool=~\"$nodepool\"})",
          "legendFormat": "{{nodepool}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Nodes launched and removed",
      "description": "Node churn per NodePool. A steady sawtooth usually means consolidation and pod requests are fighting.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (nodepool) (increase(karpenter_nodes_created_total{nodepool=~\"$nodepool\"}[$__rate_interval]))",
          "legendFormat": "created {{nodepool}}"
        },
        {
          "refId": "B",
          "expr": "-sum by (nodepool) (increase(karpenter_nodes_terminated_total{nodepool=~\"$nodepool\"}[$__rate_interval]))",
          "legendFormat": "removed {{nodepool}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Disruption decisions",
      "description": "Why Karpenter replaced or removed nodes: consolidation, drift, expiry (expireAfter 720h) or emptiness.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (decision, reason) (increase(karpenter_voluntary_disruption_decisions_total[$__rate_interval]))",
          "legendFormat": "{{decision}} / {{reason}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Spot interruptions and EC2 errors",
      "description": "Interruption messages read from the SQS queue, and failed EC2 calls by method.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (message_type) (increase(karpenter_interruption_received_messages_total[$__rate_interval]))",
          "legendFormat": "interruption {{message_type}}"
        },
        {
          "refId": "B",
          "expr": "sum by (method, error) (increase(karpenter_cloudprovider_errors_total[$__rate_interval]))",
          "legendFormat": "error {{method}} {{error}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    }
  ]
}
