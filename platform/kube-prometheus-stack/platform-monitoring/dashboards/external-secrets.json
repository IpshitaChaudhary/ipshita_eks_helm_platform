{
  "uid": "platform-external-secrets",
  "title": "Platform / External Secrets",
  "tags": [
    "platform",
    "external-secrets",
    "eks"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus"
      },
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(externalsecret_status_condition, namespace)",
          "refId": "namespace"
        },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Controller up",
      "description": "External Secrets controller being scraped. 0 fires ExternalSecretsControllerDown.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(up{job=\"external-secrets-metrics\"}) or vector(0)",
          "legendFormat": ""
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "ExternalSecrets ready",
      "description": "ExternalSecrets whose last sync succeeded.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(max by (namespace, name) (externalsecret_status_condition{condition=\"Ready\", status=\"True\", namespace=~\"$namespace\"}) == 1) or vector(0)",
          "legendFormat": ""
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "ExternalSecrets not ready",
      "description": "Not synced: stale credentials, or a Secret that was never created. Fires ExternalSecretNotReady after 15m.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(max by (namespace, name) (externalsecret_status_condition{condition=\"Ready\", status=\"False\", namespace=~\"$namespace\"}) == 1) or vector(0)",
          "legendFormat": ""
        }
      ]
    },
    {
      "id": 4,
      "type": "table",
      "title": "Not ready right now",
      "description": "One row per ExternalSecret to look at: kubectl -n <namespace> describe externalsecret <name>.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (namespace, name) (externalsecret_status_condition{condition=\"Ready\", status=\"False\", namespace=~\"$namespace\"}) == 1",
          "legendFormat": "",
          "instant": true,
          "format": "table"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Sync calls and errors",
      "description": "Reconciles per second. Errors that don't recover usually mean the IRSA role or a missing key in Secrets Manager.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(externalsecret_sync_calls_total{namespace=~\"$namespace\"}[$__rate_interval]))",
          "legendFormat": "syncs"
        },
        {
          "refId": "B",
          "expr": "sum by (namespace, name) (rate(externalsecret_sync_calls_error{namespace=~\"$namespace\"}[$__rate_interval]))",
          "legendFormat": "errors {{namespace}}/{{name}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Provider API calls by status",
      "description": "Calls to AWS Secrets Manager. A rise in errors here comes before ExternalSecrets go not ready.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 10,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (provider, call, status) (rate(externalsecret_provider_api_calls_count[$__rate_interval]))",
          "legendFormat": "{{call}} {{status}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    }
  ]
}
